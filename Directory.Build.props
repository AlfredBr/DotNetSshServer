<Project>
  <!-- Override the Platform env var (set by VS developer shells) so MSBuild
       resolves the solution configuration as "Debug|Any CPU" rather than
       the invalid "Debug|x64". -->
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <Platform>Any CPU</Platform>
  </PropertyGroup>

  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Override with -p:SpectreConsoleVersion=... to test compatibility. -->
    <SpectreConsoleVersion Condition="'$(SpectreConsoleVersion)' == ''">0.57.2</SpectreConsoleVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
